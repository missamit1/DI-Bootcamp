<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RSS Facts Feed</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
  body { background: #f4f6f2; color: #22352e; font-family: Arial, sans-serif; margin: 0; }
  .navbar { background: #183d32; padding: 18px 5%; display: flex; gap: 25px; }
  .navbar a { color: white; text-decoration: none; }
  main { max-width: 1000px; margin: 40px auto; padding: 0 20px; }
  .intro { margin-bottom: 30px; }
  .post { background: white; border: 1px solid #d7e0d8; border-radius: 12px; padding: 25px; margin-bottom: 22px; }
  .post h2 { font-size: 24px; }
  .post a { color: #1c6048; }
  .metadata { color: #5e6f65; font-size: 14px; }
  .content { white-space: pre-line; overflow-wrap: anywhere; line-height: 1.7; }
  .search-box { background: white; padding: 22px; border-radius: 12px; margin-bottom: 18px; }
  label { display: block; margin-bottom: 8px; font-weight: bold; }
  input, select { padding: 10px; width: 100%; margin-bottom: 12px; }
  button { background: #1c6048; color: white; padding: 10px 20px; border: 0; border-radius: 6px; }
  footer { padding: 30px; text-align: center; color: #5e6f65; }
</style>
